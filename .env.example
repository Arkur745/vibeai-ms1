# =========================================================================
# VibeAI Audio Intelligence Microservice Environment Variables Example
# Copy this file to '.env' and substitute with actual secrets.
# =========================================================================

# Environment Mode configuration
ENV=production
DEBUG=False

# Inter-Service Trust boundary secret (Strictly verified on /api/v1 calls)
VIBEAI_INTERNAL_SECRET=your_vibe_secure_trust_secret_token_here

# Redis Broker Urls (For Celery Task Queuing)
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS S3 Audio File Store Credentials (Required for download and upload steps)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
S3_BUCKET_NAME=vibeai-audio-storage

# Port of worker Prometheus exporter
WORKER_METRICS_PORT=8001

# GradCAM overlay images configuration
GRADCAM_RETENTION_DAYS=7
